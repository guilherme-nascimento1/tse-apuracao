# oficial (padrão, dados reais do TSE) | simulado | mock (dados fictícios para demonstração)
TSE_MODE=oficial
# Sobrescreve a URL base (opcional). Padrões:
#   simulado -> https://resultados-sim.tse.jus.br/simulado/simulado2026
#   oficial  -> https://resultados.tse.jus.br/oficial
# TSE_BASE_URL=
# Ciclo (pasta ele20XX) e turno (1 ou 2)
TSE_CICLO=ele2026
TSE_TURNO=1
TSE_USER_AGENT=tse-apuracao/1.0 (painel de apuracao; contato: voce@exemplo.com)
# Intervalo de polling no backend (30-60s recomendado)
POLL_INTERVAL_S=45
# Por quanto tempo um arquivo continua sendo atualizado depois da última consulta
ACTIVE_WINDOW_S=600
# Mock: duração da "apuração" (0 a 100%) e pausa em 100% antes de reiniciar
MOCK_DURATION_S=300
MOCK_HOLD_S=60
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info
